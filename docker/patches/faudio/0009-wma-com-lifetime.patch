--- a/src/FAudio_platform_win32_wmadec.c
+++ b/src/FAudio_platform_win32_wmadec.c
@@ -22,4 +22,5 @@
 {
 	IMFTransform *decoder;
+	CO_MTA_USAGE_COOKIE mta_cookie;
 	IMFSample *output_sample;
 
@@ -295,2 +296,16 @@
 	FAudio_memset(impl, 0, sizeof(*impl));
+
+	/* Wine 10's wmadmod delegates activation to CoCreateInstance. Games can
+	 * create voices on worker threads without initializing COM. Keep one MTA
+	 * reference per decoder, including overlapping voices, so activation and
+	 * decoding remain valid until the last decoder is released. Unlike
+	 * CoInitializeEx/CoUninitialize, this may be released on another thread
+	 * and does not change an explicitly initialized caller's apartment. */
+	hr = CoIncrementMTAUsage(&impl->mta_cookie);
+	if (FAILED(hr))
+	{
+		LOG_ERROR(voice->audio, "CoIncrementMTAUsage returned %#x", hr);
+		voice->audio->pFree(impl);
+		return hr;
+	}
 
@@ -298,6 +313,8 @@
 	if (FAILED(hr))
 	{
-		voice->audio->pFree(impl->output_buf);
-		return -2;
+		LOG_ERROR(voice->audio, "WMA decoder activation returned %#x", hr);
+		CoDecrementMTAUsage(impl->mta_cookie);
+		voice->audio->pFree(impl);
+		return hr;
 	}
 
@@ -600,4 +617,5 @@
 	if (impl->output_sample) IMFSample_Release(impl->output_sample);
 	IMFTransform_Release(impl->decoder);
+	CoDecrementMTAUsage(impl->mta_cookie);
 	voice->audio->pFree(impl->output_buf);
 	voice->audio->pFree(voice->src.wmadec);

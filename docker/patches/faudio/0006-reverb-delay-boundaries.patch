--- a/src/FAudioFX_reverb.c
+++ b/src/FAudioFX_reverb.c
@@ -87,7 +87,8 @@
 	FAudio_assert(delay_ms >= 0 && delay_ms <= DSP_DELAY_MAX_DELAY_MS);
 
 	filter->sampleRate = sampleRate;
-	filter->capacity = MsToSamples(DSP_DELAY_MAX_DELAY_MS, sampleRate);
+	/* Keep the maximum delay distinct from zero after ring wraparound. */
+	filter->capacity = MsToSamples(DSP_DELAY_MAX_DELAY_MS, sampleRate) + 1;
 	filter->delay = MsToSamples(delay_ms, sampleRate);
 	filter->read_idx = 0;
 	filter->write_idx = filter->delay;
@@ -125,7 +126,15 @@
 
 static inline float DspDelay_Process(DspDelay *filter, float sample_in)
 {
-	float delay_out = DspDelay_Read(filter);
+	float delay_out;
+
+	/* Reading first at zero delay would replay an entire ring of history. */
+	if (filter->delay == 0)
+	{
+		DspDelay_Write(filter, sample_in);
+		return DspDelay_Read(filter);
+	}
+	delay_out = DspDelay_Read(filter);
 	DspDelay_Write(filter, sample_in);
 	return delay_out;
 }

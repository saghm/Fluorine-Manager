+/* Filter each send before adding it to the shared destination. Filtering
+ * the destination itself also filters every voice already mixed into it.
+ * A bounded scratch block avoids allocations on the audio thread. */
+static void FAudio_INTERNAL_MixSend(
+	FAudioVoice *voice,
+	uint32_t send,
+	uint32_t frames,
+	float *input,
+	float *output,
+	uint32_t channels
+) {
+	float filtered[256 * MAX_CHANNELS];
+	uint32_t count, i;
+
+	if (!(voice->sends.pSends[send].Flags & FAUDIO_SEND_USEFILTER))
+	{
+		voice->sendMix[send](frames, voice->outputChannels, channels,
+			input, output, voice->mixCoefficients[send]);
+		return;
+	}
+
+	FAudio_assert(channels <= MAX_CHANNELS);
+	while (frames > 0)
+	{
+		count = FAudio_min(frames, 256);
+		FAudio_zero(filtered, count * channels * sizeof(float));
+		voice->sendMix[send](count, voice->outputChannels, channels,
+			input, filtered, voice->mixCoefficients[send]);
+		FAudio_INTERNAL_FilterVoice(voice->audio, &voice->sendFilter[send],
+			voice->sendFilterState[send], filtered, count, channels);
+		for (i = 0; i < count * channels; i += 1)
+		{
+			output[i] += filtered[i];
+		}
+		input += count * voice->outputChannels;
+		output += count * channels;
+		frames -= count;
+	}
+}
